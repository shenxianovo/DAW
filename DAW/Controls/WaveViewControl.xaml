<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DAW.Controls.WaveViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DAW.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 预览区（与编辑区左对齐） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <xaml:CanvasControl Grid.Column="1"
                                x:Name="PreviewCanvasControl"
                                Draw="PreviewCanvasControl_Draw"
                                PointerPressed="OnPreviewCanvasPointerPressed"
                                PointerMoved="OnPreviewCanvasPointerMoved"
                                PointerReleased="OnPreviewCanvasPointerReleased"
                                PointerCaptureLost="OnPreviewCanvasPointerCaptureLost"/>
        </Grid>

        <!-- 编辑区（dB 刻度 + 波形） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <xaml:CanvasControl Grid.Column="0"
                                x:Name="DbScaleCanvasControl"
                                Draw="DbScaleCanvasControl_Draw"/>

            <xaml:CanvasControl Grid.Column="1"
                                x:Name="EditorCanvasControl"
                                Draw="EditorCanvasControl_Draw"
                                PointerPressed="OnEditorCanvasPointerPressed"
                                PointerMoved="OnEditorCanvasPointerMoved"
                                PointerReleased="OnEditorCanvasPointerReleased"
                                PointerWheelChanged="OnEditorCanvasPointerWheelChanged"
                                PointerExited="OnEditorCanvasPointerExited"/>
        </Grid>

        <!-- 时间轴 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <xaml:CanvasControl Grid.Column="1"
                                x:Name="TimeAxisCanvasControl"
                                Draw="TimeAxisCanvasControl_Draw"/>
        </Grid>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Padding="50,3,8,3">
            <TextBlock x:Name="CursorInfoText" FontSize="11" Opacity="0.7" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</UserControl>
